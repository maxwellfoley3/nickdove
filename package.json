{
  "name": "mcrumps",
  "version": "1.0.0",
  "description": "Nick Dove's portfolio website",
  "main": "server.js",
  "scripts": {
    "start": "npm run css && node server.js",
    "serve": "node server.js",
    "css": "npx tailwindcss -i src/css/style.css -o src/css/dist/style.css",
    "css:watch": "npx tailwindcss -i src/css/style.css -o src/css/dist/style.css --watch"
  },
  "keywords": [
    "eleventy",
    "tailwind",
    "author",
    "website"
  ],
  "author": "Nick Dove",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "multer": "^2.2.0",
    "nunjucks": "^3.2.4",
    "tailwindcss": "^3.4.17",
    "taos": "^2.0.1"
  }
}
