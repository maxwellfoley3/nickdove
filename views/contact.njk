{% extends "base.njk" %}

{% block content %}
<div class="prose prose-lg max-w-none">

    <div class="bg-white rounded-lg shadow-sm p-8 mb-8">
        {% if contactHtml %}
            {{ contactHtml | safe }}
        {% else %}
        <h2 class="text-2xl font-semibold text-gray-900 mb-6" style="margin-top: 0">Get in Touch</h2>
        <p class="text-gray-600 mb-6">
            If you're interested in my work and want to reach out, you can  reach me via email or social media. Hit my inbox at <b>ncdove at protonmail dot com</b>, or you can give me a follow and message me on <a href="https://twitter.com/manabovetown">X</a> (formerly Twitter) or <a href="https://instagram.com/manabovetown">Instagram</a>.
        </p>
        {% endif %}
    </div>
</div>
{% endblock %}
