{% extends "base.njk" %}

{% block content %}
<div class="prose prose-lg max-w-none">
    <!-- Collection Header -->
    <div class="mb-8">
        <nav class="text-sm text-gray-500 mb-4">
            <a href="/" class="hover:text-gray-700" style="color: #7a7a7a">← Back to Photography</a>
        </nav>

        <p class="text-xl text-gray-600">{{ description }}</p>
    </div>

    <!-- Carousel Section -->
    <div class="bg-white rounded-lg shadow-sm p-8 mb-12">

        <div class="relative">
            <!-- Carousel Container -->
            <div class="overflow-hidden rounded-lg">
                <div id="carousel-container" class="flex transition-transform duration-500 ease-in-out">
                    {% for img in images %}
                    <div class="w-full flex-shrink-0">
                        <div class="aspect-video bg-gray-200 rounded-lg overflow-hidden">
                            <img
                                src="{{ img.url }}"
                                alt="{{ title }} - Image {{ loop.index }}"
                                class="m-0 w-full h-full object-cover"
                                loading="lazy"
                            />
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Navigation Buttons -->
            <button
                id="prev-btn"
                class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-black bg-opacity-50 hover:bg-opacity-75 text-white p-2 rounded-full transition-all duration-200"
                aria-label="Previous image"
            >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
            </button>

            <button
                id="next-btn"
                class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-black bg-opacity-50 hover:bg-opacity-75 text-white p-2 rounded-full transition-all duration-200"
                aria-label="Next image"
            >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>

            <!-- Dots Indicator -->
            <div class="flex justify-center mt-4 space-x-2">
                {% for img in images %}
                <button
                    class="carousel-dot w-2 h-2 rounded-full bg-gray-300 hover:bg-gray-400 transition-colors duration-200 {% if loop.first %}bg-gray-600{% endif %}"
                    data-slide="{{ loop.index0 }}"
                    aria-label="Go to slide {{ loop.index }}"
                ></button>
                {% endfor %}
            </div>
        </div>
    </div>
    <!-- Photo Grid -->

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for img in images %}
            <div class="aspect-square bg-gray-200 rounded-lg overflow-hidden group cursor-pointer" style="margin-top: 0"
                 onclick="goToSlideAndScroll({{ loop.index0 }})">
                <img
                    src="{{ img.url }}"
                    alt="{{ title }} - Image {{ loop.index }}"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" style="margin-top: 0"
                    loading="lazy"
                />
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Carousel JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('carousel-container');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const dots = document.querySelectorAll('.carousel-dot');

    let currentSlide = 0;
    const totalSlides = {{ images | length }};

    function updateCarousel() {
        const translateX = -currentSlide * 100;
        container.style.transform = `translateX(${translateX}%)`;

        // Update dots
        dots.forEach((dot, index) => {
            dot.classList.toggle('bg-gray-600', index === currentSlide);
            dot.classList.toggle('bg-gray-300', index !== currentSlide);
        });
    }

    function nextSlide() {
        currentSlide = (currentSlide + 1) % totalSlides;
        updateCarousel();
    }

    function prevSlide() {
        currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
        updateCarousel();
    }

    function goToSlide(slideIndex) {
        currentSlide = slideIndex;
        updateCarousel();
    }

    window.goToSlideAndScroll = function(slideIndex) {
        goToSlide(slideIndex);
        const carouselSection = document.querySelector('.bg-white.rounded-lg.shadow-sm.p-8.mb-12');
        if (carouselSection) {
            carouselSection.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
    };

    nextBtn.addEventListener('click', nextSlide);
    prevBtn.addEventListener('click', prevSlide);

    dots.forEach((dot, index) => {
        dot.addEventListener('click', () => goToSlide(index));
    });
});
</script>
{% endblock %}
